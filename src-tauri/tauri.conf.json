{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firmar Vecipp",
  "version": "0.2.1",
  "identifier": "com.firmar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Firmar Vecipp",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "center": true,
        "backgroundColor": "#112535"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "assets/fonts/LICENSE_LIBERATION": "licenses/LICENSE_LIBERATION"
    },
    "publisher": "Vecipp Soluciones",
    "copyright": "© 2026 Vecipp Soluciones",
    "shortDescription": "Firma electrónica de documentos, 100 % sin conexión",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYwOTcyMDRBOUZDMzAyODUKUldTRkFzT2ZTaUNYWUx1aVJnUmRNWGRHNW9HbFlKd1o5Yml0ejhhWFJQMThsdUt6YXlsL05JVEsK",
      "endpoints": [
        "https://github.com/DangerDutyJS/Firmar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
